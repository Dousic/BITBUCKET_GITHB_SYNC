# =============================================================================
# Dousic webOS — Environment Variables
# =============================================================================
#
# Copy this file to .env.production or .env.development and fill in values.
# Variables prefixed with REACT_APP_ are injected at build time by Enact.
# NEVER commit .env* files with real values.

# ---- API endpoint ----
# API base URL — the BARE host, no path suffix. api.js appends
# `/api/webos/v1/<endpoint>`, so this must be just the scheme + host (no path).
#
# The API lives on its own subdomain, api.dousic.media — consistent with
# ws.dousic.media and *.dousic-cdn.com. The backend is deployed under an
# /api/webos/v1 route prefix, so the bare host below yields
# https://api.dousic.media/api/webos/v1/... (matches the live API). The app CSP
# already allows https://*.dousic.media, so no policy change is needed.
REACT_APP_API_URL=https://api.dousic.media

# ---- WebSocket (Reverb via pusher-js) ----
# Reverb speaks the Pusher protocol; pusher-js is the client.
# For local dev: REACT_APP_WS_HOST=localhost, PORT=8080, TLS=false
# For prod:     REACT_APP_WS_HOST=ws.dousic.media, PORT=443, TLS=true
REACT_APP_WS_KEY=dousic-key-6ae2A2uIDb38GR3l
REACT_APP_WS_HOST=ws.dousic.media
REACT_APP_WS_PORT=443
REACT_APP_WS_TLS=true

# ---- Environment ----
# 'production' enables telemetry forwarding + disables console logs
# 'staging'    targets staging infrastructure, enables debug logs
# 'development' local dev, verbose logging
NODE_ENV=production

# ---- Release ----
# Release identifier for telemetry tagging; matches appinfo.json version.
REACT_APP_RELEASE=1.1.0

# ---- Feature flags ----
# Dou-Stitch Live is deferred past MVP. Keep this false for the first
# LG submission; re-enable when the feature is reintroduced.
REACT_APP_FEATURE_DOU_STITCH=false

# Voice search not wired for MVP.
REACT_APP_FEATURE_VOICE_SEARCH=false

# ---- Build options ----
# When true, VideoPlayer skips the hls.js dynamic import and relies on the
# TV's native HLS pipeline. Saves ~400KB bundle on webOS 4.5+ (all currently
# supported targets), so this should be 'true' for production webOS builds.
# Set to 'false' only when building the app for a non-webOS target (future
# web client) or for an older TV that lacks native HLS.
REACT_APP_NATIVE_HLS_ONLY=true
